# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Intelligent Document Extraction, Validation & API Platform"

# Database Settings (PostgreSQL)
# For local development:
# DATABASE_URL=postgresql://user:password@localhost:5432/document_intelligence
# On Render / cloud deployments, set DATABASE_URL to your managed PostgreSQL connection string:
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# OCR Settings (Tesseract)
# On Linux / Render / Docker: Tesseract is typically installed in system PATH (/usr/bin/tesseract).
# In that environment, leave TESSERACT_CMD unset or commented out.
# On Windows or custom installations, specify the full executable path:
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
# TESSERACT_CMD="/usr/bin/tesseract"

# LLM Extraction Settings (Google Gemini)
# Provider: 'gemini' (default) or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Primary Model: default is 'gemini-3.6-flash'
# Deterministic temperature: 0.0 for financial extraction accuracy
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.0

# Gemini Model Fallback Strategy:
# The client implements an automated resilient fallback ladder:
# 1. Primary Model: The configured LLM_MODEL (default: gemini-3.6-flash) is attempted first.
# 2. Flash Pool Cascade: On 429 quota exhaustion or daily quota limits, it cascades
#    through regular Flash models: gemini-3.6-flash -> gemini-3.7-flash -> gemini-3.8-flash -> gemini-3.5-flash -> gemini-3-flash.
# 3. Flash Lite Pool: Only after all regular Flash models are exhausted does it failover
#    to Flash Lite models: gemini-3.5-flash-lite -> gemini-3.1-flash-lite.
# 4. Transient Errors: Transient 503 or network errors retry with exponential backoff before fallback.

# Optional alternative provider settings (e.g. OpenAI or compatible endpoints)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=

# Financial Validation Settings
# Configurable rounding tolerance threshold for variance checks (default: 0.01)
FINANCIAL_VALIDATION_TOLERANCE=0.01
