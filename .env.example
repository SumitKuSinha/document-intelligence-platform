# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Intelligent Document Extraction, Validation & API Platform"

# OCR Settings
# Path to the Tesseract executable (useful on Windows or non-standard PATH installs)
TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"

# LLM Extraction Settings (Google Gemini 2.5 Flash)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE="0.0"

# Optional alternative provider settings (e.g. OpenAI or compatible endpoints)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_BASE_URL=""

# Database Settings
# DATABASE_URL=postgresql://user:password@localhost:5432/document_intelligence

# Financial Validation Settings
# Configurable tolerance for rounding differences (e.g. 0.01 for 1 cent / unit)
FINANCIAL_VALIDATION_TOLERANCE="0.01"


